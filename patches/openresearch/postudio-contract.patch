+const POSTUDIO_PORT: &str = "ORX_POSTUDIO_TRACKIO_PORT";
+
+fn parse_reserved_port(value: Option<&str>) -> Result<Option<u16>, String> {
+    value
+        .map(|value| {
+            let port: u16 = value.parse().map_err(|_| {
+                format!("{POSTUDIO_PORT} must be a valid nonzero loopback TCP port.")
+            })?;
+            if port == 0 {
+                return Err(format!(
+                    "{POSTUDIO_PORT} must be a valid nonzero loopback TCP port."
+                ));
+            }
+            Ok(port)
+        })
+        .transpose()
+}
+
+pub fn reserved_port() -> Result<Option<u16>, String> {
+    match std::env::var(POSTUDIO_PORT) {
+        Ok(value) => parse_reserved_port(Some(&value)),
+        Err(std::env::VarError::NotPresent) => Ok(None),
+        Err(error) => Err(format!("Could not read {POSTUDIO_PORT}: {error}")),
+    }
+}
