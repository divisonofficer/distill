+fn snapshot_git(path: &std::path::Path, args: &[&str]) -> ApiResult<std::process::Output> {
+    let mut command = crate::local::git::git_command();
+    command.current_dir(path).args(args);
+    let mut command = tokio::process::Command::from(command);
+    command.kill_on_drop(true);
+    match tokio::runtime::Handle::current()
+        .block_on(async { tokio::time::timeout(Duration::from_secs(10), command.output()).await })
+    {
+        Ok(output) => output
+            .map_err(crate::error::Error::from)
+            .map_err(Into::into),
+        Err(_) => Err(Failure::Message(
+            StatusCode::CONFLICT,
+            "Git snapshot command timed out after 10 seconds".into(),
+        )),
+    }
+}
+
+fn git_snapshot_output(path: &std::path::Path, args: &[&str]) -> ApiResult<String> {
+    let output = snapshot_git(path, args)?;
+    if !output.status.success() {
+        return Err(Failure::Message(
+            StatusCode::CONFLICT,
+            "Cannot validate experiment workspace".into(),
+        ));
+    }
+    Ok(String::from_utf8_lossy(&output.stdout).trim().to_owned())
+}
+
+fn snapshot_value(
+    api: &Api,
+    project_id: &str,
+    experiment_id: &str,
+    create: bool,
+) -> ApiResult<Value> {
+    let store = api.store();
+    let experiment = store
+        .get_local_experiment(experiment_id)?
+        .ok_or_else(|| Failure::Message(StatusCode::NOT_FOUND, "Experiment not found.".into()))?;
+    if experiment.project_id != project_id {
+        return Err(Failure::Message(
+            StatusCode::NOT_FOUND,
+            "Experiment not found in project.".into(),
+        ));
+    }
+    let project = store
+        .get_local_project(project_id)?
+        .ok_or_else(|| Failure::Message(StatusCode::NOT_FOUND, "Project not found.".into()))?;
+    let repo = PathBuf::from(&project.repo_path);
+    let head = git_snapshot_output(
+        &repo,
+        &[
+            "rev-parse",
+            "--verify",
+            &format!("{}^{{commit}}", experiment.branch_name),
+        ],
+    )?;
+    if !matches!(head.len(), 40 | 64) || !head.bytes().all(|byte| byte.is_ascii_hexdigit()) {
+        return Err(Failure::Message(
+            StatusCode::CONFLICT,
+            "Cannot validate experiment branch commit".into(),
+        ));
+    }
+    let workspace = crate::store::data_dir()
+        .join("worktrees")
+        .join("postudio")
+        .join(project_id)
+        .join(experiment_id);
+    let mut path = if workspace.join(".git").exists() {
+        Some(workspace.clone())
+    } else {
+        None
+    };
+    let worktree = if create {
+        if let Some(path) = &path {
+            path.clone()
+        } else {
+            std::fs::create_dir_all(workspace.parent().unwrap())
+                .map_err(crate::error::Error::from)?;
+            let workspace_utf8 = workspace.to_str().ok_or_else(|| {
+                Failure::Message(
+                    StatusCode::BAD_REQUEST,
+                    "Workspace path is not valid UTF-8.".into(),
+                )
+            })?;
+            let output = snapshot_git(
+                &repo,
+                &[
+                    "-c",
+                    "core.hooksPath=/dev/null",
+                    "worktree",
+                    "add",
+                    "--",
+                    workspace_utf8,
+                    &experiment.branch_name,
+                ],
+            )?;
+            if !output.status.success() {
+                return Err(Failure::Message(
+                    StatusCode::CONFLICT,
+                    String::from_utf8_lossy(&output.stderr).trim().to_string(),
+                ));
+            }
+            path = Some(workspace.clone());
+            workspace.clone()
+        }
+    } else {
+        path.clone().unwrap_or(repo.clone())
+    };
+    let head_path = if worktree.join(".git").exists() {
+        worktree.clone()
+    } else {
+        repo.clone()
+    };
+    if path.is_some() {
+        let branch =
+            git_snapshot_output(&head_path, &["symbolic-ref", "--quiet", "--short", "HEAD"])?;
+        let actual = git_snapshot_output(&head_path, &["rev-parse", "HEAD"])?;
+        let common = git_snapshot_output(
+            &head_path,
+            &["rev-parse", "--path-format=absolute", "--git-common-dir"],
+        )?;
+        let expected_common = git_snapshot_output(
+            &repo,
+            &["rev-parse", "--path-format=absolute", "--git-common-dir"],
+        )?;
+        if branch != experiment.branch_name
+            || actual != head
+            || std::fs::canonicalize(common).ok() != std::fs::canonicalize(expected_common).ok()
+        {
+            return Err(Failure::Message(StatusCode::CONFLICT,"Experiment workspace changed repository, branch or commit; restore it before approving a snapshot.".into()));
+        }
+    }
+    let count = if path.is_some() {
+        let output = snapshot_git(
+            &head_path,
+            &[
+                "-c",
+                "core.fsmonitor=false",
+                "status",
+                "--porcelain=v1",
+                "--untracked-files=all",
+                "-z",
+            ],
+        )?;
+        if output.status.success() {
+            Some(
+                output
+                    .stdout
+                    .split(|byte| *byte == 0)
+                    .filter(|entry| !entry.is_empty())
+                    .count(),
+            )
+        } else {
+            None
+        }
+    } else {
+        None
+    };
+    let output = if path.is_some() {
+        git_snapshot_output(&head_path, &["branch", "--show-current"])
+            .unwrap_or_else(|_| experiment.branch_name.clone())
+    } else {
+        experiment.branch_name.clone()
+    };
+    let result = ExperimentSnapshot {
+        head_commit: head,
+        uncommitted_count: count,
+        worktree_path: path.map(|p| p.to_string_lossy().into_owned()),
+        branch: output.trim().to_string(),
+        cwd: create.then(|| worktree.to_string_lossy().into_owned()),
+    };
+    serde_json::to_value(result)
+        .map_err(crate::error::Error::from)
+        .map_err(Into::into)
+}
+
+async fn reconnect(State(api): State<Arc<Api>>, Path(id): Path<String>) -> ApiResult<Json<Value>> {
+    let run = api.run(&id)?;
+    if Phase::parse(&run.status).is_some_and(Phase::is_terminal) {
+        return Ok(Json(api.view(&run)?));
+    }
+    let handle = handle_of(&run).ok_or_else(|| {
+        Failure::Message(StatusCode::CONFLICT, "Run has no native handle yet".into())
+    })?;
+    if let crate::engine::handle::Handle::Ssh { host, .. }
+    | crate::engine::handle::Handle::Slurm { host, .. } = &handle
+    {
+        retry_host(State(api.clone()), Path(host.clone())).await?;
+    }
+    let backend = api.commands.backend(&run)?;
+    let watched = [WatchedRun {
+        id: id.clone(),
+        handle,
+    }];
+    let observations = backend.observe(&watched, Duration::from_secs(3)).await;
+    api.engine
+        .apply_observations(backend.as_ref(), &watched, observations)
+        .await;
+    Ok(Json(api.view(&api.run(&id)?)?))
+}
